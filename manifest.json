{
  "manifest_version": 3,
  "name": "yanhekttool",
  "version": "1.2.0",
  "description": "课程搜索、学期筛选、往年目录扫描与本地缓存。",
  "minimum_chrome_version": "102",
  "permissions": ["storage", "scripting", "activeTab", "tabs"],
  "optional_host_permissions": ["https://raw.githubusercontent.com/*"],
  "host_permissions": [
    "https://www.yanhekt.cn/*",
    "https://cbiz.yanhekt.cn/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "yanhekttool",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["https://www.yanhekt.cn/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://www.yanhekt.cn/*"],
      "js": ["hook.js"],
      "run_at": "document_start",
      "world": "ISOLATED"
    }
  ]
}
